{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "executables": {
      "description": "在 PATH 上找的可执行文件名，缺省是 [id]；如 python 找 python3 再找 python",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported": {
      "type": "string",
      "minLength": 1,
      "description": "应用认识的版本范围，写法同 requires 的 version"
    },
    "detect": {
      "type": "object",
      "properties": {
        "args": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "版本命令的参数，如 [--version]；Go 是 [version]"
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "正则，第一个捕获组是版本号"
        }
      },
      "required": ["args", "pattern"],
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "properties": {
        "darwin": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https:\\/\\/\\S+$",
              "description": "官网链接，安装提示里始终一起给出"
            },
            "versionManagers": {
              "description": "版本管理工具（如 nvm）的安装命令，按优先顺序",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "command": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["id", "command"],
                "additionalProperties": false
              }
            },
            "homebrew": {
              "type": "object",
              "properties": {
                "command": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": ["command"],
              "additionalProperties": false
            }
          },
          "required": ["url"],
          "additionalProperties": false
        }
      },
      "required": ["darwin"],
      "additionalProperties": false
    }
  },
  "required": ["formatVersion", "id", "supported", "detect", "install"],
  "additionalProperties": false
}
