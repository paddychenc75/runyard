{
  "formatVersion": 1,
  "id": "node-ts",
  "kind": "oneshot",
  "needs": ["node"],
  "check": {
    "command": [
      "node",
      "-e",
      "const { stripTypeScriptTypes } = require('node:module'); stripTypeScriptTypes(require('node:fs').readFileSync(process.argv[1], 'utf8'));",
      "{entry}"
    ],
    "timeoutMs": 5000
  },
  "run": { "command": ["node", "{entry}"], "stdin": true },
  "preview": { "type": "console" },
  "watch": {
    "mode": "rerun",
    "paths": ["**/*.ts"],
    "ignore": ["node_modules/**"],
    "debounceMs": 300
  },
  "stop": { "mode": "graceful", "graceMs": 2000 }
}
