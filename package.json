{
  "name": "runyard-monorepo",
  "private": true,
  "description": "Runyard 工作区根；这里只放根命令和工具链依赖，不放业务依赖",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "node tooling/scripts/run-tests.ts",
    "test:unit": "turbo run test",
    "test:process": "turbo run test:process --concurrency=1",
    "check": "node tooling/checks/run.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm check && node tooling/scripts/run-tests.ts --affected",
    "deps:lookup": "node tooling/scripts/deps-lookup.ts",
    "generate": "node tooling/scripts/generate.ts",
    "template:lint": "node tooling/scripts/template-data.ts",
    "template:smoke": "node tooling/scripts/template-smoke.ts",
    "test:template": "node tooling/scripts/template-smoke.ts",
    "i18n:build": "node packages/i18n/build/build.ts",
    "spec": "node tooling/scripts/spec.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fission-ai/openspec": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
