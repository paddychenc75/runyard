{
  "name": "runyard-monorepo",
  "private": true,
  "description": "Runyard 工作区根；这里只放根命令和工具链依赖，不放业务依赖",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "turbo run test",
    "check": "node tooling/checks/run.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm check && turbo run test --affected",
    "deps:lookup": "node tooling/scripts/deps-lookup.ts",
    "generate": "node tooling/scripts/generate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
