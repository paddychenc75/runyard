{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "../../.tsbuild/desktop-renderer",
    "tsBuildInfoFile": "../../.tsbuild/desktop-renderer/tsconfig.tsbuildinfo",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "jsx": "react-jsx"
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "test-support/**/*.ts"
  ],
  "references": [
    { "path": "../../packages/protocol" },
    { "path": "../../packages/i18n" },
    { "path": "../../packages/tokens" },
    { "path": "../../packages/ui" }
  ]
}
