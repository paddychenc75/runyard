{
  "name": "@runyard/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "\u684c\u9762\u5e94\u7528\u7684\u6700\u65e9\u5916\u58f3\uff1a\u4e3b\u8fdb\u7a0b\u3001\u9884\u52a0\u8f7d\u811a\u672c\u3001\u754c\u9762\uff1b\u4ece\u6e90\u7801\u7528 pnpm dev \u6253\u5f00",
  "type": "module",
  "main": "dist/main/index.mjs",
  "scripts": {
    "build": "node build.ts",
    "dev": "node build.ts && electron dist/main/index.mjs",
    "smoke": "node build.ts && electron dist/main/index.mjs --smoke",
    "smoke:editor": "node build.ts && electron dist/main/index.mjs --editor-smoke",
    "smoke:terminal": "node build.ts && electron dist/main/index.mjs --terminal-smoke",
    "test": "vitest run --project unit",
    "e2e": "node build.ts && playwright test --config e2e/playwright.config.ts",
    "e2e:run": "playwright test --config e2e/playwright.config.ts",
    "test:process": "vitest run --project process --passWithNoTests",
    "package": "node ../../tooling/scripts/package-desktop.ts",
    "electron:download": "install-electron",
    "visual:screens": "playwright test --config visual/playwright.config.ts && node visual/check-results.ts && node visual/check-budget.ts",
    "visual:scan": "node visual/probe.ts"
  },
  "dependencies": {
    "@runyard/client": "workspace:*",
    "@runyard/i18n": "workspace:*",
    "@runyard/platform": "workspace:*",
    "@runyard/protocol": "workspace:*",
    "@runyard/tokens": "workspace:*",
    "@runyard/ui": "workspace:*",
    "@shikijs/monaco": "catalog:",
    "@vue/language-server": "catalog:",
    "@vue/typescript-plugin": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/addon-search": "catalog:",
    "@xterm/addon-web-links": "catalog:",
    "@xterm/xterm": "catalog:",
    "monaco-editor": "catalog:",
    "node-pty": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@electron/fuses": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "vitest": "catalog:"
  }
}
