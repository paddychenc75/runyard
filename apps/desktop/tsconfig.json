{
  "extends": "../../tooling/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "../../.tsbuild/desktop",
    "tsBuildInfoFile": "../../.tsbuild/desktop/tsconfig.tsbuildinfo",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "build.ts",
    "package.json"
  ],
  "references": [
    { "path": "../../packages/protocol" },
    { "path": "../../packages/platform" },
    { "path": "../../packages/i18n" },
    { "path": "../../packages/tokens" },
    { "path": "../../packages/client" },
    { "path": "./tsconfig.renderer.json" }
  ]
}
