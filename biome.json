{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.tsbuild",
      "!**/.turbo",
      "!pnpm-lock.yaml",
      "!docs/design",
      "!tooling/design-render/build",
      "!tooling/design-render/png",
      "!tooling/design-render/sheets"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "json": {
    "parser": { "allowComments": true }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noImportCycles": "error"
      },
      "correctness": {
        "noPrivateImports": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/desktop/src/renderer/**", "packages/ui/src/**", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": {
              "level": "error",
              "options": {
                "noStrings": false,
                "ignoreProps": true,
                "allowedStrings": ["·", "›", ":"]
              }
            }
          }
        }
      },
      "plugins": [
        "./tooling/biome/native-attr-literal.grit",
        "./tooling/biome/jsx-child-literal.grit"
      ]
    },
    {
      "includes": ["packages/cli/src/**", "!**/*.test.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "error" } } }
    },
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "electron 只许出现在 apps/desktop 里（技术设计 §3.2 规则 1）"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/protocol/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    }
  ]
}
