{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.tsbuild",
      "!**/.turbo",
      "!packages/ui/visual/.output",
      "!apps/desktop/e2e/.output",
      "!**/dist",
      "!pnpm-lock.yaml",
      "!.release-please-manifest.json",
      "!docs/design",
      "!tooling/design-render/build",
      "!tooling/design-render/png",
      "!tooling/design-render/sheets"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "json": {
    "parser": { "allowComments": true }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noImportCycles": "error"
      },
      "correctness": {
        "noPrivateImports": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/desktop/src/renderer/**",
        "packages/ui/src/**",
        "packages/i18n/src/react/**",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noJsxLiterals": {
              "level": "error",
              "options": {
                "noStrings": false,
                "ignoreProps": true,
                "allowedStrings": ["·", "›", ":"]
              }
            }
          }
        }
      },
      "plugins": [
        "./tooling/biome/native-attr-literal.grit",
        "./tooling/biome/jsx-child-literal.grit"
      ]
    },
    {
      "includes": ["packages/ui/src/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": { "rules": { "correctness": { "noNodejsModules": "error" } } }
    },
    {
      "includes": ["apps/desktop/src/renderer/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "界面进程里不许用 electron（技术设计 §3.2 规则 1、2）；只用 window.runyard",
                  "@runyard/client": "界面进程只许导入 protocol（只用类型）和 i18n，连接管理进程是主进程的事（技术设计 §3.2）",
                  "@runyard/platform": "界面进程只许导入 protocol（只用类型）和 i18n（技术设计 §3.2）",
                  "@runyard/core": "界面进程只许导入 protocol（只用类型）和 i18n（技术设计 §3.2）",
                  "@runyard/supervisor": "界面进程只许导入 protocol（只用类型）和 i18n（技术设计 §3.2）"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/preload/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@runyard/client": "预加载脚本只转发，不导入业务包（技术设计 §3.2：preload 只导入 protocol）",
                  "@runyard/platform": "预加载脚本只转发，不导入业务包（技术设计 §3.2：preload 只导入 protocol）",
                  "@runyard/i18n": "预加载脚本只转发，不导入业务包（技术设计 §3.2：preload 只导入 protocol）"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cli/src/**", "!**/*.test.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "error" } } }
    },
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "electron 只许出现在 apps/desktop 里（技术设计 §3.2 规则 1）"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/protocol/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    }
  ]
}
